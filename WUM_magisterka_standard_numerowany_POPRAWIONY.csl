<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-GB">
 <info>
  <title>WUM Magisterka – standard uczelni (numerowany)</title>
  <id>http://www.zotero.org/styles/wum-magisterka-standard-numerowany</id>
  <link href="http://www.zotero.org/styles/wum-magisterka-standard-numerowany" rel="self"/>
  <author><name>Custom style based on supplied university guidelines</name></author>
  <category citation-format="numeric"/>
  <summary>Numerowany styl: artykuły, książki, rozdziały i strony internetowe.</summary>
  <updated>2026-11-09T00:00:00+00:00</updated>
 </info>
 <locale xml:lang="en-GB">
  <terms><term name="editor" form="short">Red.</term><term name="et-al">i wsp.</term></terms>
 </locale>
 <macro name="author">
  <names variable="author" et-al-min="7" et-al-use-first="6">
   <name name-as-sort-order="all" sort-separator=" " initialize-with="." delimiter=", " delimiter-precedes-last="never"/>
   <substitute><names variable="editor"><name name-as-sort-order="all" sort-separator=" " initialize-with="." delimiter=", "/></names><text variable="title"/></substitute>
  </names>
 </macro>
 <macro name="editor">
  <names variable="editor" et-al-min="7" et-al-use-first="6">
   <name name-as-sort-order="all" sort-separator=" " initialize-with="." delimiter=", " delimiter-precedes-last="never"/>
   <label form="short" prefix=" (" suffix=")"/>
  </names>
 </macro>
 <macro name="year"><date variable="issued"><date-part name="year"/></date></macro>
 <macro name="access-date"><date variable="accessed"><date-part name="day" suffix=" "/><date-part name="month" form="long" suffix=" "/><date-part name="year"/></date></macro>
 <citation collapse="citation-number"><layout prefix="[" suffix="]" delimiter=", "><text variable="citation-number"/></layout></citation>
 <bibliography second-field-align="flush">
  <sort><key variable="citation-number"/></sort>
  <layout><text variable="citation-number" suffix=". "/>
   <choose>
    <if type="article-journal article-magazine article-newspaper" match="any">
     <group delimiter=", "><text macro="author"/><text variable="title"/><text variable="container-title" form="short"/><group delimiter=": "><text macro="year"/><group delimiter=" "><text variable="volume"/><text variable="page"/></group></group></group><text suffix="."/>
    </if>
    <else-if type="chapter paper-conference" match="any">
     <group delimiter=", "><text macro="author"/><group delimiter=" "><text value="w"/><text macro="editor"/><text variable="container-title"/></group><text variable="publisher"/><text variable="publisher-place"/><text macro="year"/><text variable="page"/></group><text suffix="."/>
    </else-if>
    <else-if type="book">
     <group delimiter=", "><text macro="author"/><text variable="title"/><text variable="publisher"/><text variable="publisher-place"/><text macro="year"/><text variable="page"/></group><text suffix="."/>
    </else-if>
    <else-if type="webpage post-weblog" match="any">
     <group delimiter=". "><text macro="author"/><text variable="title"/><group delimiter=" "><text value="Version current"/><date variable="issued"><date-part name="day" suffix=" "/><date-part name="month" form="long" suffix=" "/><date-part name="year"/></date></group><group delimiter=" "><text value="Internet:"/><text variable="URL"/></group><group delimiter=" "><text value="(accessed"/><text macro="access-date"/><text value=")"/></group></group><text suffix="."/>
    </else-if>
    <else><group delimiter=", "><text macro="author"/><text variable="title"/><text variable="publisher"/><text variable="publisher-place"/><text macro="year"/><text variable="page"/></group><text suffix="."/></else>
   </choose>
  </layout>
 </bibliography>
</style>